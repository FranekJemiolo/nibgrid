{
  "name": "nibgrid",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first, zero-server BYOK/BYOM PWA for turning hand-drawn sketches into style-locked 2D game sprites (https://franekjemiolo.github.io/nibgrid/).",
  "homepage": "https://franekjemiolo.github.io/nibgrid/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\" \"packages/*/scripts/**/*.ts\" \"desktop/scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\" \"packages/*/scripts/**/*.ts\" \"desktop/scripts/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build:ext": "vite build --config packages/vscode-extension/vite.config.ts && node --experimental-strip-types packages/vscode-extension/scripts/verify-extension-bundle.ts",
    "smoke:desktop": "node --experimental-strip-types desktop/scripts/smoke-desktop-bundle.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "dexie": "^4.0.11",
    "fflate": "^0.8.3",
    "lucide-react": "^0.483.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
